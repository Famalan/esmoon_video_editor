# Postgres
POSTGRES_USER=videoslicer
POSTGRES_PASSWORD=videoslicer
POSTGRES_DB=videoslicer
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=video-slicer

# API
API_PORT=8000

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# LLM (polza.ai, OpenAI-compatible gateway)
POLZA_API_KEY=
POLZA_BASE_URL=https://api.polza.ai/api/v1
POLZA_MODEL=google/gemini-3.1-flash-lite

# Whisper fallback
WHISPER_MODEL=base
